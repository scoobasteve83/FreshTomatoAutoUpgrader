# INSTALLATION INSTRUCTIONS:
# 1. Log into your router's Web GUI (e.g., http://192.168.1.1)
# 2. In the left-hand sidebar menu, navigate to: 
#    Administration -> Scheduler
# 3. Scroll down to the "Custom Commands" or "Cron" settings section.
# 4. Paste this entire code block into the command entry text field.
# 5. Set your preferred execution intervals (e.g., Daily at 03:00 AM).
# 6. Click "Save" at the bottom of the page to apply the schedule.
#
# FILESYSTEM PLACEMENT REQUIREMENTS:
# * The main "FTAA.sh" script MUST be saved on the ROOT folder of your 
#   physically attached USB drive (e.g., /tmp/mnt/sda1/FTAA.sh).
# =========================================================================

# 1. Immediate Gate: Abort if FreshTomato's update alert file doesn't exist
if [ ! -f "/tmp/freshtomato_update_available" ]; then
    # Exit quietly without cluttering your system log
    exit 0
fi

logger -t "FTAA_LOADER" "[STATUS] Native GUI update alert triggered. Initiating USB mount audit..."

# 2. Proceed with Physical USB Discovery since an update is confirmed
USB_PATH=""
for m in /tmp/mnt/* /mnt/*; do
    [ -d "$m" ] && [ "$m" != "/tmp/mnt/*" ] && [ "$m" != "/mnt/*" ] && [ "$(df -k "$m" | awk 'NR==2{print $4}')" -gt 61440 ] && USB_PATH="$m" && break
done

if [ -z "$USB_PATH" ]; then
    logger -t "FTAA_LOADER" "[CRITICAL] Update flag is active, but no eligible USB drive is connected. Aborting execution."
    exit 1
fi

MAIN_SCRIPT="$USB_PATH/FTAA.sh"

if [ -f "$MAIN_SCRIPT" ]; then
    logger -t "FTAA_LOADER" "[STATUS] Launching upgrade script from secure USB mount..."
    chmod +x "$MAIN_SCRIPT"
    "$MAIN_SCRIPT"
else
    logger -t "FTAA_LOADER" "[CRITICAL] Execution script $MAIN_SCRIPT missing from the USB drive root."
    exit 1
fi
